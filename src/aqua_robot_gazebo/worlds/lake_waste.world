        </visual>
      </link>
    </model>
    <model name="shore_west">
      <static>true</static>
      <pose>-15 0 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1 30 4</size></box></geometry></collision>
